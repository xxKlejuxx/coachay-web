rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'phone' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isAnonymous() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function inMyClub(clubId) {
      return isAnonymous() || (
        clubId != null &&
        exists(/databases/$(database)/documents/authIndex/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authIndex/$(request.auth.uid)).data.clubIds.hasAny([clubId])
      );
    }

    // 2026-09-26: kolekcje bez własnego clubId (tasks, messages) mają tylko teamId —
    // trzeba dociągnąć clubId z dokumentu teams/{teamId}, żeby użyć inMyClub().
    function teamClubId(teamId) {
      return teamId != null && exists(/databases/$(database)/documents/teams/$(teamId))
        ? get(/databases/$(database)/documents/teams/$(teamId)).data.clubId
        : null;
    }
    function inMyTeam(teamId) {
      return inMyClub(teamClubId(teamId));
    }

    // notifications są kluczowane po `userId` aplikacji (nie Auth UID) — authIndex.userId to mapping.
    function myAppUserId() {
      return exists(/databases/$(database)/documents/authIndex/$(request.auth.uid))
        ? get(/databases/$(database)/documents/authIndex/$(request.auth.uid)).data.userId
        : null;
    }

    // memberships bywają odpytywane tylko po playerId (bez userId/clubId/teamId) — trzeba
    // dociągnąć clubId z players/{playerId}, analogicznie do teamClubId (2026-09-26, hotfix memberships)
    function playerClubId(playerId) {
      return playerId != null && exists(/databases/$(database)/documents/players/$(playerId))
        ? get(/databases/$(database)/documents/players/$(playerId)).data.clubId
        : null;
    }

    // authIndex — tylko własny dokument
    match /authIndex/{authUid} {
      allow read, write: if request.auth != null && request.auth.uid == authUid;
    }

    // users — create podczas rejestracji (przed weryfikacją emaila), read/update przez zweryfikowanych
    match /users/{userId} {
      allow read: if isVerified() || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if isVerified();
    }

    // clubs — create podczas rejestracji (przed weryfikacją emaila); inMyClub() gwarantuje izolację
    match /clubs/{clubId} {
      allow read: if isVerified() && inMyClub(clubId);
      allow create: if request.auth != null && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(clubId);
    }

    // memberships — create podczas rejestracji; legacy docs z clubId==null dostępne dla zweryfikowanych.
    // 2026-09-26 (hotfix): odczyt jest odpytywany przez klienta różnymi filtrami (userId, clubId,
    // teamId, samo playerId) w kilkudziesięciu miejscach web — pojedyncza gałąź po clubId nie
    // wystarczała (Firestore odrzuca całe zapytanie-listę gdy where() nie pasuje do pola w regule).
    // Osobna, sprawdzalna gałąź na każde faktycznie używane pole filtra.
    match /memberships/{membershipId} {
      allow read: if isVerified() && (
        resource.data.userId == myAppUserId() ||
        inMyClub(resource.data.clubId) ||
        inMyTeam(resource.data.teamId) ||
        inMyClub(playerClubId(resource.data.playerId))
      );
      allow create: if request.auth != null && (request.resource.data.clubId == null || inMyClub(request.resource.data.clubId));
      allow update, delete: if isVerified() && (resource.data.clubId == null || inMyClub(resource.data.clubId));
    }

    // teams — izolacja po clubId
    match /teams/{teamId} {
      allow read: if isVerified() && inMyClub(resource.data.clubId);
      allow create: if request.auth != null && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(resource.data.clubId);
    }

    // trainers — create podczas rejestracji
    match /trainers/{trainerId} {
      allow read: if isVerified() && inMyClub(resource.data.clubId);
      allow create: if request.auth != null && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(resource.data.clubId);
    }

    // players — izolacja po clubId; legacy docs z clubId==null dostępne dla zweryfikowanych
    match /players/{playerId} {
      allow read: if isVerified() && (resource.data.clubId == null || inMyClub(resource.data.clubId));
      allow create: if request.auth != null && (request.resource.data.clubId == null || inMyClub(request.resource.data.clubId));
      allow update, delete: if isVerified() && (resource.data.clubId == null || inMyClub(resource.data.clubId));
    }

    // inviteCodes — odczyt publiczny (weryfikacja kodu przed rejestracją), zapis przez zweryfikowanych
    match /inviteCodes/{codeId} {
      allow read: if true;
      allow create: if isVerified() && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(resource.data.clubId);
    }

    // 2026-09-26: PILNE (zgłoszone przez APP, sync #0047) — poniższe kolekcje trafiały do
    // catch-all na dole (isVerified() bez żadnego scopingu klub/drużyna) — każdy zalogowany
    // user (nawet konto z innego klubu) mógł czytać/pisać dane WSZYSTKICH klubów: harmonogramy,
    // treść czatu, powody nieobecności (dane zdrowotne dzieci), zadania, dane licencyjne.
    //
    // 2026-09-26 (sync #0057): powyższa naprawa NIE działała od dnia wdrożenia, bo Firestore
    // OR-uje reguły po ścieżce — catch-all na dole pasował też do tych kolekcji i wygrywał
    // przez OR niezależnie od scopingu poniżej. Naprawione przez usunięcie catch-alla.

    // events — harmonogram/mecze (type:'MECZ' z matchData) — izolacja przez teamId -> clubId.
    // 2026-09-26 (hotfix po deployu #0057-fix): realne zapytanie klienta filtruje po teamId
    // (getTeamEvents), a reguła sprawdzała clubId — niezgodność pola query vs. reguły powodowała
    // że Firestore odrzucał CAŁE zapytanie-listę (PERMISSION_DENIED), zamiast filtrować per-dokument.
    // Efekt: pusty dashboard/kalendarz dla wszystkich. Naprawione przez sprawdzanie teamId
    // (ten sam wzorzec co messages/tasks) - izolacja klubowa zostaje, bo inMyTeam i tak dociąga clubId.
    match /events/{eventId} {
      allow read: if isVerified() && inMyTeam(resource.data.teamId);
      allow create: if request.auth != null && inMyTeam(request.resource.data.teamId);
      allow update, delete: if isVerified() && inMyTeam(resource.data.teamId);
    }

    // absences — dane zdrowotne/nieobecności dzieci — izolacja po clubId
    match /absences/{absenceId} {
      allow read: if isVerified() && inMyClub(resource.data.clubId);
      allow create: if request.auth != null && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(resource.data.clubId);
    }

    // trainingTopics — izolacja po clubId
    match /trainingTopics/{topicId} {
      allow read: if isVerified() && inMyClub(resource.data.clubId);
      allow create: if request.auth != null && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(resource.data.clubId);
    }

    // tasks — mają tylko teamId (bez clubId) — izolacja przez teams/{teamId}.clubId
    match /tasks/{taskId} {
      allow read: if isVerified() && inMyTeam(resource.data.teamId);
      allow create: if request.auth != null && inMyTeam(request.resource.data.teamId);
      allow update, delete: if isVerified() && inMyTeam(resource.data.teamId);
    }

    // messages — czat drużynowy (funkcja appki mobilnej) — izolacja przez teamId -> clubId
    match /messages/{messageId} {
      allow read: if isVerified() && inMyTeam(resource.data.teamId);
      allow create: if request.auth != null && inMyTeam(request.resource.data.teamId);
      allow update, delete: if isVerified() && inMyTeam(resource.data.teamId);
    }

    // announcements — ogłoszenia drużynowe (auto-generowane + BROADCAST od trenera) —
    // izolacja przez teamId -> clubId (dodane 2026-09-26, sync #0057 — wcześniej opierało
    // się wyłącznie na catch-allu)
    match /announcements/{announcementId} {
      allow read: if isVerified() && inMyTeam(resource.data.teamId);
      allow create: if request.auth != null && inMyTeam(request.resource.data.teamId);
      allow update, delete: if isVerified() && inMyTeam(resource.data.teamId);
    }

    // matches — wg decisions.md kolekcja zlikwidowana (mecze żyją w events, type:'MECZ');
    // zostaje zabezpieczona tak samo jak events na wypadek zalegających/starych dokumentów.
    match /matches/{matchId} {
      allow read: if isVerified() && inMyClub(resource.data.clubId);
      allow create: if request.auth != null && inMyClub(request.resource.data.clubId);
      allow update, delete: if isVerified() && inMyClub(resource.data.clubId);
    }

    // notifications — per-user (kluczowane po userId aplikacji, nie Auth UID)
    match /notifications/{notifId} {
      allow read: if isVerified() && resource.data.userId == myAppUserId();
      allow create: if request.auth != null && request.resource.data.userId == myAppUserId();
      allow update, delete: if isVerified() && resource.data.userId == myAppUserId();
    }

    // access_rights — dane licencyjne (uid + club_id). Scoping po club_id (nie tylko własny uid),
    // bo P4 (sloty rodzinne) wymaga że dziecko (KIBIC) czyta wpis RODZICA w tym samym klubie —
    // ograniczenie do samego siebie złamałoby tę funkcję.
    match /access_rights/{arId} {
      allow read: if isVerified() && inMyClub(resource.data.club_id);
      allow write: if request.auth != null && inMyClub(request.resource.data.club_id);
    }

    // config — np. config/legal (wersje zgód RODO/polityka prywatności) — potrzebny odczyt
    // PRZED logowaniem/rejestracją (dodane 2026-09-26, sync #0058/#0059 — zgłoszone przez APP,
    // kolekcja w produkcji jeszcze pusta/nieużywana przez web, ale kod app się już do niej odwołuje)
    match /config/{doc} {
      allow read: if true;
      allow write: if false; // zarządzane z konsoli/Cloud Function, nie przez klienta
    }

    // 2026-09-26 (sync #0057): catch-all USUNIĘTY — pasował też do kolekcji już obsłużonych
    // wyżej i przez OR unieważniał ich scoping (patrz sync #0057 - APP potwierdziło #0058).
    // Firestore domyślnie ODMAWIA dostępu gdy żadna reguła nie pasuje - to jest bezpieczny
    // stan domyślny dla kolekcji poza tą listą (np. sparringOffers - martwy feature bez
    // ekranu w web/app; platform_metrics, push_receipts - wyłącznie Cloud Functions/Admin SDK,
    // które i tak omijają te reguły).
  }
}
