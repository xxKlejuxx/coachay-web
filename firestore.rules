rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Użytkownicy — userId to czytelny kod (user_ROLA_DATA_NR), authUid to Firebase Auth UID
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Memberships
    match /memberships/{membershipId} {
      allow read, write: if request.auth != null;
    }

    // Invite codes — read publiczny (weryfikacja kodu przed rejestracją)
    match /inviteCodes/{codeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Drużyny
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // Wszystkie pozostałe — każdy zalogowany (w tym anonimowo w demo mode)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
