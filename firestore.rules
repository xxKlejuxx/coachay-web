rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Zweryfikowany = email potwierdzony LUB logowanie telefonem LUB tryb demo (anonymous)
    function isVerified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'phone' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    // Users
    match /users/{userId} {
      allow read, write: if isVerified();
    }

    // Memberships
    match /memberships/{membershipId} {
      allow read, write: if isVerified();
    }

    // Invite codes — read publiczny (weryfikacja kodu przed rejestracją)
    match /inviteCodes/{codeId} {
      allow read: if true;
      allow write: if isVerified();
    }

    // Drużyny
    match /teams/{teamId} {
      allow read, write: if isVerified();
    }

    // Wszystkie pozostałe — tylko zweryfikowani
    match /{document=**} {
      allow read, write: if isVerified();
    }
  }
}
